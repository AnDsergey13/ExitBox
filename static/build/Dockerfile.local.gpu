# syntax=docker/dockerfile:1
# ==============================================================================
# ExitBox GPU Local Intermediary (User Creation + exitbox-allow)
# Thin layer on top of the GPU base image. Same job as Dockerfile.local, with
# Debian's user tools instead of BusyBox's.
# ==============================================================================

ARG BASE_IMAGE=exitbox-base-gpu-published
FROM ${BASE_IMAGE}

ARG USER_ID=1000
ARG GROUP_ID=1000
ARG USERNAME=user

ENV HOME=/home/${USERNAME} \
    PATH="/home/${USERNAME}/.local/bin:/usr/local/bin:${PATH}"

# Create the non-root user. Ubuntu images ship a default account on UID 1000
# ("ubuntu"), and the host's GID may already belong to a system group, so both
# are removed before the ExitBox user takes the id.
RUN existing_user=$(getent passwd ${USER_ID} | cut -d: -f1) && \
    if [ -n "$existing_user" ] && [ "$existing_user" != "${USERNAME}" ]; then \
        userdel -r "$existing_user" 2>/dev/null || true; \
    fi && \
    existing_group=$(getent group ${GROUP_ID} | cut -d: -f1) && \
    if [ -n "$existing_group" ] && [ "$existing_group" != "${USERNAME}" ]; then \
        groupdel "$existing_group" 2>/dev/null || true; \
    fi && \
    groupadd -g ${GROUP_ID} ${USERNAME} && \
    useradd -u ${USER_ID} -g ${USERNAME} -s /bin/bash -d /home/${USERNAME} -m ${USERNAME} && \
    mkdir -p /home/${USERNAME}/.local/bin && \
    mkdir -p /home/${USERNAME}/.config && \
    mkdir -p /home/${USERNAME}/.cache && \
    chown -R ${USERNAME}:${USERNAME} /home/${USERNAME}

# Set up workspace
RUN mkdir -p /workspace && chown ${USERNAME}:${USERNAME} /workspace
